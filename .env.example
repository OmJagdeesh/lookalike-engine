# PostgreSQL connection string (use SSL & encryption at rest in staging/production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lookalike_engine

# Google Places API (official API for enrichment & expansion)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# LLM API key (used ONLY for plain-language 3-sentence ICP summaries, never scoring)
LLM_API_KEY=your_llm_api_key_here

# Budget guardrails for Google Places API (INR)
PLACES_MAX_BUDGET_INR=2000
PLACES_MAX_PER_BUSINESS_INR=5
